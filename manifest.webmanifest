{
  "name": "AIM",
  "short_name": "AIM",
  "description": "Your private chat with Claude, ChatGPT and Gemini on your own computer.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone"],
  "background_color": "#3d4046",
  "theme_color": "#3d4046",
  "icons": [
    { "src": "icon-192.png?v=3", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png?v=3", "sizes": "512x512", "type": "image/png" }
  ],
  "shortcuts": [
    { "name": "Voice mode", "short_name": "Voice", "url": "./?open=voice", "icons": [{ "src": "icon-192.png?v=3", "sizes": "192x192" }] },
    { "name": "Live camera", "short_name": "Camera", "url": "./?open=cam", "icons": [{ "src": "icon-192.png?v=3", "sizes": "192x192" }] },
    { "name": "Atlas", "short_name": "Atlas", "url": "./atlas-staging/", "icons": [{ "src": "atlas-staging/icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "title", "text": "say", "url": "url" }
  }
}
