{
  "name": "Atlas",
  "short_name": "Atlas",
  "description": "Your AI assistant: talk live in Hebrew or English, and watch it build websites in real code.",
  "id": "./",
  "start_url": "./?src=home",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone"],
  "orientation": "portrait",
  "background_color": "#07080C",
  "theme_color": "#07080C",
  "lang": "he",
  "dir": "auto",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Talk", "short_name": "Talk", "url": "./?tab=talk", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "New build", "short_name": "Build", "url": "./?tab=builds", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
